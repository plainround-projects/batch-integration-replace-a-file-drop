# Copied to .env by `make up` the first time. Every value here is a throwaway for containers on this machine.
# Nothing in this file is a real secret; change the values if you share the machine.

POSTGRES_PORT=55561
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=local-only-password

RABBIT_PORT=56721
RABBIT_MANAGEMENT_PORT=56722
RABBIT_USER=orderflow
RABBIT_PASSWORD=local-only-password

# The pretend partner's SFTP account (user "partner"). 56222 on this machine, 22 inside the network.
SFTP_PORT=56222
SFTP_PASSWORD=partner-pass

# What the programs on the host read (the containers get theirs from docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:55561/orderflow
DB_USER=orderflow
DB_PASSWORD=local-only-password
RABBIT_HOST=localhost
SFTP_HOST=localhost

# The flow polls the folder every 5 seconds; a publish waits 5 seconds for the broker's confirmation; the legacy path may
# be retired after 14 nights in a row without a difference.
ORDERFLOW_POLL_SECONDS=5
ORDERFLOW_CONFIRM_TIMEOUT_MILLIS=5000
ORDERFLOW_CLEAN_NIGHTS_TO_RETIRE=14
